{
  "name": "auto-tiktok-stock-video-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:browsers": "playwright install chromium",
    "brief": "node scripts/new-brief.mjs",
    "generate": "node scripts/generate.mjs",
