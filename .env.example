TIKTOK_CLIENT_KEY=aw15vwhnibowzq06
TIKTOK_CLIENT_SECRET=put_your_client_secret_here
TIKTOK_REDIRECT_URI=https://getwod5.github.io/BourseIO/tiktok-callback.html
TIKTOK_SCOPES=user.info.basic,user.info.stats,video.list,video.upload

# draft = sends the video to your TikTok inbox for final posting in the app.
# direct = posts through Direct Post API. Unaudited apps are restricted to SELF_ONLY/private.
TIKTOK_POST_MODE=draft

# Linux voice-over (optional): when set, Piper is used instead of the local
# espeak-ng fallback. Keep the matching .onnx.json file beside the model.
# PIPER_PATH=/usr/local/bin/piper
# PIPER_VOICE_PATH=/home/bourseio/.local/share/piper/fr_FR-siwis-medium.onnx
